#include<limits.h>
bool isPalindrome(int x) {

    int  res=0;
    int rem=0;
    long int ans=0;
    int  temp=x;
    if(x<0){
        return false;
        }

    else{
        while(x>0)
        {
            rem=x%10;
            ans=ans*10+rem;
            x=x/10;

        }
        return ans==temp;
    }


    
}
