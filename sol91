class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        if(m==1 && n==0 )
        {
            System.out.println("[1]");
            
        }
        if(m==0 && n==1 )
        {
            System.out.println("[1]");
            
        }
        int ans[]=new int[m+n];
        int k=0;
        int i=0;
        int j=0;
        while(i<m && j<n){
                if(nums1[i]<=nums2[j])
                {
                    ans[k++]=nums1[i++];

                }
                else{
                    ans[k++]=nums2[j++];
                }
        }
        while(i<m)
        {
            ans[k++]=nums1[i++];
        }
         while(j<n)
        {
            ans[k++]=nums2[j++];
        }
            
        System.out.print("[");
        for(int p=0;p<ans.length;p++)
        {
            nums1[p]=ans[p];
            System.out.print(nums1[p]+",");
        }
        System.out.print("]");
    }
}
