int lengthOfLastWord(char* s) {
    int l=strlen(s);
    int count=0;
    while(l>0)
    {
        if(s[l-1]==' ')
        {
            l--;
        }
        else{
            break;
        }
    }
    for(int i=l-1;i>=0;i--)
    {
        if(s[i]!=' '){
            count++;
        }
        else{
            break;
        }
    }
    return count;
}
