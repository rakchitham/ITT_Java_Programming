class Solution {
    public int jump(int[] nums) {
        int f = 0,
            count = 0,
            cE = 0;

        for(int i=0; i<nums.length - 1; i++) {
            f = Math.max(f, i + nums[i]);

            if(i == cE) {
                count++;
                cE = f;
                if(cE >= nums.length - 1) break;
            }
        }
        return count;
    }
}
